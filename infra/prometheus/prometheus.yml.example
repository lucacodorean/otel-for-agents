# Rendered to prometheus.yml (git-ignored) by `otel_setup prometheus render-config`.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

# Accept late samples (e.g. a Collector WAL backlog) instead of rejecting them as
# "out of bounds", which blocks the exporter's WAL. Set by
# DEV_PROMETHEUS_OUT_OF_ORDER_WINDOW (.env, defaults to DEV_PROMETHEUS_RETENTION).
storage:
  tsdb:
    out_of_order_time_window: __OUT_OF_ORDER_WINDOW__

rule_files:
  - recording-rules.yml

scrape_configs:
  # Self-scrape only. The web config enforces basic auth on every endpoint,
  # including /metrics, so the scrape authenticates with the dev user.
  - job_name: prometheus
    scheme: __SCHEME__
    basic_auth:
      username: __USERNAME__
      password_file: /etc/prometheus/scrape-password
    tls_config:
      insecure_skip_verify: true   # loopback inside the container, dev only
    static_configs:
      - targets: ["localhost:9090"]
