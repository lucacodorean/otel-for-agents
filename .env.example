# Copy to .env (git-ignored) and adjust. Validated on load by otel_setup.

# --- Prometheus endpoint (remote write target; dev or production) ----------
# Full remote-write URL. Use https:// when PROMETHEUS_TLS_ENABLED=true.
# The Collector runs in Docker: 127.0.0.1 would be the container itself. Dev: the Prometheus
# container on the shared network. Production: the server's real URL.
PROMETHEUS_REMOTE_WRITE_URL=http://prometheus:9090/api/v1/write
PROMETHEUS_USERNAME=otel
PROMETHEUS_PASSWORD=change-me
PROMETHEUS_TLS_ENABLED=false
# Optional CA certificate (PEM) on the host, mounted read-only into the containers.
PROMETHEUS_CA_FILE=
# Dev only. Never true in production.
PROMETHEUS_INSECURE_SKIP_VERIFY=false

# --- Grafana (local, infra/grafana) -----------------------------------------
# URL you open Grafana at (also its root URL).
GRAFANA_URL=http://127.0.0.1:3000
# Host port (on 127.0.0.1).
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Required to start Grafana. No quotes, $, backslashes or whitespace.
GRAFANA_ADMIN_PASSWORD=
# Prometheus as seen from the Grafana container. Dev: the Prometheus container on otel-net.
GRAFANA_PROMETHEUS_URL=http://prometheus:9090
# Data source credentials; empty = reuse PROMETHEUS_USERNAME / PROMETHEUS_PASSWORD. Grafana only
# reads, so a separate read-only user is better in production.
GRAFANA_PROMETHEUS_USERNAME=
GRAFANA_PROMETHEUS_PASSWORD=

# --- Marketplaces ----------------------------------------------------------
# Comma-separated name=source[@ref] entries. Source is a git URL or a local path.
#   MARKETPLACES=acme-internal=https://git.example.com/acme/marketplace.git@main
MARKETPLACES=
# Comma-separated plugin names outside any configured marketplace.
EXTRA_PLUGIN_ALLOWLIST=
# drop = keep only data points matching a configured marketplace; label = keep all.
FILTER_MODE=drop

# --- Quality signals ---------------------------------------------------------
# true: also collect Claude Code *events* (skill activations, tool results, subagent runs,
# hook runs) and turn them into counters. Events are read in memory and never stored; only a
# few safe attributes become metric labels. Needs OTEL_LOG_TOOL_DETAILS=1 (already set by
# `enable`), which makes events carry tool details (see README, Privacy). Run `enable` after
# changing it.
QUALITY_SIGNALS=true

# --- Collector -------------------------------------------------------------
# Image tag of otel/opentelemetry-collector-contrib.
COLLECTOR_VERSION=0.162.0
# Path inside the Collector container (Docker volume collector-wal); rarely needs changing.
COLLECTOR_WAL_DIR=/var/lib/otelcol/wal
# Timezone of the Collector's log timestamps (IANA name). UTC = GMT+0.
# Examples: UTC, Europe/Bucharest, Etc/GMT-3 (note the inverted sign: Etc/GMT-3 is UTC+3).
COLLECTOR_TIMEZONE=UTC
# Claude Code metrics export interval (milliseconds).
METRICS_EXPORT_INTERVAL_MS=60000

# --- Development Prometheus (infra/prometheus) -----------------------------
# Used by `docker compose --env-file ../../.env up -d` from infra/prometheus.
DEV_PROMETHEUS_PORT=9090
# How long to keep data (e.g. 12h, 2d, 30d, 1y). 0 = no time limit, which needs
# DEV_PROMETHEUS_RETENTION_SIZE (Prometheus would otherwise fall back to 15d).
DEV_PROMETHEUS_RETENTION=2d
# Optional disk cap (e.g. 512MB, 20GB); the oldest data is dropped first. Empty = no cap.
DEV_PROMETHEUS_RETENTION_SIZE=
# How late a sample may arrive and still be stored. Empty = DEV_PROMETHEUS_RETENTION
# (required when that is 0).
DEV_PROMETHEUS_OUT_OF_ORDER_WINDOW=
